{
  "name": "notes-app-server",
  "version": "1.0.0",
  "description": "Notes Management Application Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test mocha tests/unit/**/*.test.js --exit",
    "test:unit": "cross-env NODE_ENV=test mocha tests/unit/**/*.test.js --exit",
    "test:integration": "cross-env NODE_ENV=test mocha tests/integration/**/*.test.js --exit",
    "db:test": "node scripts/testDb.js",
    "coverage": "cross-env NODE_ENV=test nyc --reporter=lcov --reporter=text mocha tests/unit/**/*.test.js tests/integration/**/*.test.js --exit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^11.1.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "chai": "^5.1.1",
    "cross-env": "^7.0.3",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.3",
    "nyc": "^15.1.0",
    "sinon": "^18.0.0",
    "supertest": "^7.0.0"
  }
}
